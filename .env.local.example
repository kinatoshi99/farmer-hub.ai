# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
# Supabase Project Anonymous Key (publicly safe to use in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (for Edge Functions or server-side operations requiring admin privileges - KEEP THIS SECRET)
# This is not directly used by the Next.js client, but Edge Functions will need it.
# You'll set this in your Supabase project's Edge Function settings.
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
